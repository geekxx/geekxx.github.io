<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title }}</title>
  </head>
  <body>

    <article itemscope itemtype="https://schema.org/Recipe">
      <h1 itemprop="name">{{ page.title }}</h1>

      {% if page.image %}
      <img itemprop="image" src="{{ page.image }}" alt="{{ page.title }}" />
      {% endif %}

      {% if page.author %}
      <p><strong>Author:</strong> <span itemprop="author">{{ page.author }}</span></p>
      {% endif %}

      {% if page.description %}
      <p itemprop="description">{{ page.description }}</p>
      {% endif %}

      <h2>Ingredients</h2>
      <ul>
        {% for ingredient in page.ingredients %}
        <li itemprop="recipeIngredient">{{ ingredient }}</li>
        {% endfor %}
      </ul>

      <h2>Instructions</h2>
      <ol>
        {% for step in page.instructions %}
        <li itemprop="recipeInstructions" itemscope itemtype="https://schema.org/HowToStep">
          <span itemprop="text">{{ step }}</span>
        </li>
        {% endfor %}
      </ol>

      {% if page.prep_time %}<meta itemprop="prepTime" content="{{ page.prep_time }}" />{% endif %}
      {% if page.cook_time %}<meta itemprop="cookTime" content="{{ page.cook_time }}" />{% endif %}
      {% if page.total_time %}<meta itemprop="totalTime" content="{{ page.total_time }}" />{% endif %}
      {% if page.yield %}<meta itemprop="recipeYield" content="{{ page.yield }}" />{% endif %}
      {% if page.category %}<meta itemprop="recipeCategory" content="{{ page.category }}" />{% endif %}
      {% if page.cuisine %}<meta itemprop="recipeCuisine" content="{{ page.cuisine }}" />{% endif %}

    </article>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Recipe",
      "name": {{ page.title | tojson }},
      {% if page.author %}"author": { "@type": "Person", "name": {{ page.author | tojson }} },{% endif %}
      {% if page.description %}"description": {{ page.description | tojson }},{% endif %}
      {% if page.image %}"image": [{{ page.image | tojson }}],{% endif %}
      "recipeIngredient": [
        {% for ingredient in page.ingredients %}{{ ingredient | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}
      ],
      "recipeInstructions": [
        {% for step in page.instructions %}{{ step | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}
      ]
      {% if page.prep_time %}, "prepTime": "{{ page.prep_time }}"{% endif %}
      {% if page.cook_time %}, "cookTime": "{{ page.cook_time }}"{% endif %}
      {% if page.total_time %}, "totalTime": "{{ page.total_time }}"{% endif %}
      {% if page.yield %}, "recipeYield": "{{ page.yield }}"{% endif %}
      {% if page.category %}, "recipeCategory": "{{ page.category }}"{% endif %}
      {% if page.cuisine %}, "recipeCuisine": "{{ page.cuisine }}"{% endif %}
    }
    </script>

  </body>
  </html>
